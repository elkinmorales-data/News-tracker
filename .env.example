# Copia este archivo como .env y completa con tus datos.
# En GitHub Actions estos valores van en Settings → Secrets and variables → Actions,
# NO en un archivo. Acá solo para correr los scripts en tu maquina.

# API key de DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Correo que envia (Gmail) y su app password de 16 caracteres
# (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Correo(s) que reciben, separados por coma si son varios.
# Es obligatorio: sin valor el script NO envia el correo.
TO_EMAIL=